PORT=3000
NODE_ENV=development

# Long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-change-me

# sqlite (local dev, zero install) or postgres (production)
DB_TYPE=sqlite
SQLITE_PATH=data/dev.sqlite
# DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Show the login code in the app instead of sending an SMS (default: on in development, off in production)
# EXPOSE_OTP=true

# Auto-create tables. Use migrations instead in production.
DB_SYNC=true
